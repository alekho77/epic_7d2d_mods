<?xml version="1.0" encoding="UTF-8"?>
<config>
  <!-- Enhanced Night Vision for Darker Nights mod -->
  <!-- Combines NightVision (standard green effect) + Bright (additional lighting) -->
  <!-- Provides classic NVG look with enhanced brightness for very dark nights -->
  
  <!-- Standard night vision effect -->
  <set xpath="/item_modifiers/item_modifier[@name='modArmorNightVision']/effect_group/triggered_effect[@action='ModifyScreenEffect' and @trigger='onSelfItemActivate' and @effect_name='NightVision']/@intensity">1.0</set>
  <set xpath="/item_modifiers/item_modifier[@name='modArmorNightVision']/effect_group/triggered_effect[@action='ModifyScreenEffect' and @trigger='onSelfItemActivate' and @effect_name='NightVision']/@fade">1.2</set>
  <set xpath="/item_modifiers/item_modifier[@name='modArmorNightVision']/effect_group/triggered_effect[@action='ModifyScreenEffect' and @trigger='onSelfItemDeactivate' and @effect_name='NightVision']/@intensity">0</set>
  <set xpath="/item_modifiers/item_modifier[@name='modArmorNightVision']/effect_group/triggered_effect[@action='ModifyScreenEffect' and @trigger='onSelfItemDeactivate' and @effect_name='NightVision']/@fade">1.2</set>
  <set xpath="/item_modifiers/item_modifier[@name='modArmorNightVision']/effect_group/triggered_effect[@action='ModifyScreenEffect' and @trigger='onSelfEquipStop' and @effect_name='NightVision']/@intensity">0</set>
  <set xpath="/item_modifiers/item_modifier[@name='modArmorNightVision']/effect_group/triggered_effect[@action='ModifyScreenEffect' and @trigger='onSelfEquipStop' and @effect_name='NightVision']/@fade">1.2</set>

  <!-- Additional lighting effect - Bright -->
  <append xpath="/item_modifiers/item_modifier[@name='modArmorNightVision']/effect_group">
    <triggered_effect trigger="onSelfItemActivate" action="ModifyScreenEffect" effect_name="Bright" intensity="0.9" fade="1.2"/>
    <triggered_effect trigger="onSelfItemDeactivate" action="ModifyScreenEffect" effect_name="Bright" intensity="0" fade="1.2"/>
    <triggered_effect trigger="onSelfEquipStop" action="ModifyScreenEffect" effect_name="Bright" intensity="0" fade="1.2"/>
  </append>
</config>
